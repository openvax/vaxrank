include LICENSE README.md requirements.txt
include TEST_DATA.md
recursive-include notes *.md

# The reviewed Sid recipe is package data; its reads come from openvax-v1.
# Repository-only tests remain excluded.
prune tests

recursive-include vaxrank/data/sid-recipe *
include examples/osteosarc_test_data/pin_catalog.py
include examples/build_canine_host_reference.py
include examples/wlos0001_tp53/README.md examples/wlos0001_tp53/run.py
recursive-include examples/wlos0001_tp53/data *
global-exclude *.py[cod]
